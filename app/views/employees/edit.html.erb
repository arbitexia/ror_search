<%= client_header('Edit Employee', @client, request.referrer) %>

<%= render partial: 'employees/form', locals: { url: client_employee_url(@employee.client, @employee) } %>

<% if @employee.isolved_id.nil? %>
  <%= link_to 'Delete Employee', client_employee_url(@employee.client, @employee, page: params[:page]), class: 'delete-link', data: { method: :delete, confirm: "Are you sure you would like to remove #{@employee.first_name} #{@employee.last_name}?" } %>
<% end %>